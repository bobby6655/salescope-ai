{
  "framework": "vite",
  "installCommand": "node scripts/install-public-deps.mjs",
  "buildCommand": "VITE_REQUIRE_AUTH=true npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "https://minimize-clusters-tribes-tomato.trycloudflare.com/login"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://minimize-clusters-tribes-tomato.trycloudflare.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://minimize-clusters-tribes-tomato.trycloudflare.com/api/:path*"
    },
    {
      "source": "/charts/:path*",
      "destination": "https://minimize-clusters-tribes-tomato.trycloudflare.com/charts/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
