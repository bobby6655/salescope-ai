{
  "name": "salescope-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "dev:v1": "node scripts/run-v1.mjs",
    "package:v1": "node scripts/package-v1.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "policy:import": "node scripts/import-policy.mjs",
    "check:policy": "node scripts/policy-check.mjs",
    "check:policy-browser": "node scripts/policy-browser-check.mjs",
    "check:change-browser": "node scripts/change-browser-check.mjs",
    "check:guest-history-browser": "VITE_REQUIRE_AUTH=true npm run build && node scripts/guest-history-browser-check.mjs",
    "start": "node server/production.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
