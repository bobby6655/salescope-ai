SITE_ADDRESS=analysis.example.com
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=https://analysis.example.com
# 用create-user脚本生成哈希。不要填明文密码。可配置多个账号。
AUTH_USERS_JSON={"replace-me":"scrypt:replace-with-real-salt:replace-with-real-hash"}
MAX_CONCURRENT_ANALYSES=4
# 使用公网可达的OpenAI兼容模型服务，不将公司内网地址直接用于公网服务器。
LLM_BASE_URL=https://api.example.com/v1
LLM_API_PATH=/chat/completions
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-api-key
WQ_TIMEOUT_MS=60000
WQ_DEMO_FALLBACK=false
